{
  "name": "screep-monitor",
  "version": "1.0.0",
  "description": "Screeps room-stats collector (GitHub Actions) + Firebase-hosted dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "gen:config": "node scripts/gen-web-config.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "retry-request": "^9.0.1",
    "teeny-request": "^11.0.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true
  }
}
