rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reads need a signed-in account whose Firebase Auth UID is on this
    // allowlist (public/data.js signs in with Google). UIDs are opaque random
    // ids, safe to publish: knowing one doesn't let anyone sign in as that
    // user. The web apiKey is public and authorizes nothing, so this check is
    // the access control (see README "Access control"). All writes go through
    // the Admin SDK (the GitHub Actions collector and freshness check), which
    // bypasses these rules. To add or remove a viewer, edit the list and
    // redeploy the rules.
    function isViewer() {
      return request.auth != null
        && request.auth.uid in [
          "DrnqzWvainYJ46IEPChDtZ0U9s13"
        ];
    }
    match /snapshots/{id} {
      // No client reads a single snapshot by id — only ranged/listed queries
      // from the dashboard, which always carry an explicit limit() (see
      // public/constants.js MAX_HISTORY_DOCS). The cap still bounds the cost
      // of a full-collection scan by a viewer.
      allow get: if false;
      allow list: if isViewer() && request.query.limit <= 9000;
      allow write: if false;
    }
    match /meta/{id} {
      allow read: if isViewer();
      allow write: if false;
    }
    // Multi-shard layout: same rules, one level down. The root rules above
    // stay until the legacy root collection has drained.
    match /shards/{shard}/snapshots/{id} {
      allow get: if false;
      allow list: if isViewer() && request.query.limit <= 9000;
      allow write: if false;
    }
    match /shards/{shard}/meta/{id} {
      allow read: if isViewer();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
